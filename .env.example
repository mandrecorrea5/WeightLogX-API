# ============================================
# WeightLogX API - Environment Variables
# ============================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# cp .env.example .env

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_PORT=3000

# ============================================
# Database Configuration
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=user_weightlogx
DATABASE_PASSWORD=password_segura
DATABASE_NAME=weightlogx_db
DATABASE_SSL=false
DB_LOGGING=false

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=*

# ============================================
# Upload Configuration
# ============================================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
PROFILE_IMAGE_PATH=./uploads/profiles

# ============================================
# Rate Limiting
# ============================================
# Time window for throttling in milliseconds (default: 60000 = 1 minute)
THROTTLE_TTL=60000
# Maximum requests per time window (default: 100 in dev, 60 in prod)
THROTTLE_LIMIT=100

# ============================================
# Swagger Configuration
# ============================================
ENABLE_SWAGGER=true

# ============================================
# Tracing (OpenTelemetry)
# ============================================
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SERVICE_NAME=weightlogx-api

# ============================================
# Observability - Grafana
# ============================================
# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001

# ============================================
# Observability - Prometheus
# ============================================
PROMETHEUS_PORT=9090

# ============================================
# Observability - Loki
# ============================================
LOKI_PORT=3100

# ============================================
# Cron Jobs Configuration
# ============================================
# Enable workout reminders cron job
ENABLE_CRON_REMINDERS=true
# Enable inactive athlete notifications cron job
ENABLE_CRON_INACTIVITY=true
# Days of inactivity before notifying trainer
INACTIVITY_DAYS=7
# Cron schedule for inactivity check (default: daily at 9 AM)
INACTIVITY_CRON_SCHEDULE=0 9 * * *

# ============================================
# Health Checks
# ============================================
# Health check configuration is handled by @nestjs/terminus
# No additional environment variables needed

# ============================================
# Production Notes
# ============================================
# IMPORTANT: In production, make sure to:
# 1. Set strong, unique values for JWT_SECRET and JWT_REFRESH_SECRET
# 2. Set secure DATABASE_PASSWORD
# 3. Configure CORS_ORIGIN with specific allowed origins (comma-separated)
# 4. Set DATABASE_SSL=true if using SSL connection
# 5. Set NODE_ENV=production
# 6. Change GRAFANA_USER and GRAFANA_PASSWORD to secure values
# 7. Set ENABLE_SWAGGER=false or remove it (Swagger will be disabled by default in production)
# 8. Set DB_LOGGING=false (query logging should be disabled in production)
